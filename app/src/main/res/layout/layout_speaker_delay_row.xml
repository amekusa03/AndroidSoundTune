<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_slot_card"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/textViewSpeakerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Front Left (FL)"
            android:textStyle="bold"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <TextView
            android:id="@+id/textViewSpeakerChannel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="CH: L"
            android:textStyle="bold"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <Button
            android:id="@+id/buttonMeasureSpeaker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/measure_pulse" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/textViewFlightTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="到達時間: 未測定"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <TextView
            android:id="@+id/textViewCompDelay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="補正: --"
            android:textStyle="bold"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

    </LinearLayout>

</LinearLayout>
