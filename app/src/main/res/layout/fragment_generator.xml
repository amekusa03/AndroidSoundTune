<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textViewOutputStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:text="Output: Detecting..." />

        <!-- Quick frequency presets -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/preset_title"
            android:textStyle="bold"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:layout_marginBottom="4dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="16dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupPresets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSw31"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SW 31.5Hz" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSw50"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SW 50Hz" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCross80"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cross 80Hz" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMidBass160"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mid-Bass 160Hz" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMid1k"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mid 1kHz" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipHigh4k"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="High 4kHz" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAir10k"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Air 10kHz" />

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Slot 0 -->
        <include
            android:id="@+id/slot0"
            layout="@layout/layout_tone_slot" />

        <!-- Slot 1 -->
        <include
            android:id="@+id/slot1"
            layout="@layout/layout_tone_slot" />

        <!-- Slot 2 -->
        <include
            android:id="@+id/slot2"
            layout="@layout/layout_tone_slot" />

        <!-- Slot 3 -->
        <include
            android:id="@+id/slot3"
            layout="@layout/layout_tone_slot" />

        <!-- Slot 4 -->
        <include
            android:id="@+id/slot4"
            layout="@layout/layout_tone_slot" />

        <Button
            android:id="@+id/buttonStopAll"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/stop_all" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
