<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Instructions Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="8dp"
            app:strokeWidth="1dp"
            app:strokeColor="#25888888">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/delay_guide_title"
                    android:textStyle="bold"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/delay_instructions"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Status banner for current measurement -->
        <TextView
            android:id="@+id/textViewDelayStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="測定したいスピーカーの「測定」ボタンを押してください。"
            android:textStyle="bold"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <!-- FL Row -->
        <include
            android:id="@+id/rowSpeakerFL"
            layout="@layout/layout_speaker_delay_row" />

        <!-- FR Row -->
        <include
            android:id="@+id/rowSpeakerFR"
            layout="@layout/layout_speaker_delay_row" />

        <!-- RL Row -->
        <include
            android:id="@+id/rowSpeakerRL"
            layout="@layout/layout_speaker_delay_row" />

        <!-- RR Row -->
        <include
            android:id="@+id/rowSpeakerRR"
            layout="@layout/layout_speaker_delay_row" />

        <!-- SW Row -->
        <include
            android:id="@+id/rowSpeakerSW"
            layout="@layout/layout_speaker_delay_row" />

        <!-- DSP Summary Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="8dp"
            app:cardBackgroundColor="#10000000"
            app:strokeWidth="1dp"
            app:strokeColor="#25888888">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recommended_dsp_delay"
                    android:textStyle="bold"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <TextView
                    android:id="@+id/textViewDspSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="各スピーカーを測定すると、最も遠いスピーカーに合わせたDSPディレイ設定値が表示されます。"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <Button
                    android:id="@+id/buttonResetDelays"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:text="@string/reset_delays" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
